SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set a strong random token before exposing the API to other people.
# An unset or blank token disables cloud access. All API reads and writes require it.
# Visitors use local browser storage; shared libraries are no longer supported.
# APP_WRITE_TOKEN=choose-a-private-password
